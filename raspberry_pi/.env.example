# ==============================================================================
# AgroVision Raspberry Pi — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git. It is in .gitignore.
# ==============================================================================

# AgroVision backend URL (REQUIRED)
# Local:  http://localhost:5000
# LAN:    http://192.168.1.x:5000
# Cloud:  https://your-backend-domain.com
BACKEND_URL=http://localhost:5000

# Device identity (set once, survives reboots)
DEVICE_ID=AGRO_PI_001
DEVICE_NAME=AgroVision Field Hub

# Default farm/field/user (updated automatically after device pairing)
DEFAULT_FARM_ID=farm-gv-01
DEFAULT_FIELD_ID=field-mango-01
DEFAULT_USER_ID=user-ravi-01

# Logging (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Set to true to force console/text mode even on Pi (useful for testing)
USE_CONSOLE_OLED=false

# Environment
AGROVISION_ENVIRONMENT=production

# Heartbeat interval in seconds (default: 30)
HEARTBEAT_INTERVAL_SEC=30
